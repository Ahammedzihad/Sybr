# AI-Powered Customer Support Intelligence & Phishing Threat Detection System
# Backend Environment Configuration Example (NO SECRETS COMMITTED)

# -----------------------------------------------------------------------------
# Google Gemini Configuration
# -----------------------------------------------------------------------------
# Required for live structured dual-call AI. If absent or rate-limited (HTTP 429),
# SybrV2 automatically activates its deterministic rule-based fallback engine.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Supabase PostgreSQL Configuration
# -----------------------------------------------------------------------------
# Optional for local mode. If credentials are missing or invalid, SybrV2 transparently
# persists data to local SQLite database with zero data loss.
SUPABASE_URL=https://your-project-ref.supabase.co
# IMPORTANT: Provide a server-side secret/service_role key (prefix eyJ... or sb_secret_...).
# NEVER provide a frontend publishable key (sb_publishable_...) here, as PostgREST RLS
# will block server-side dual writes and list queries.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# -----------------------------------------------------------------------------
# Authentication & Access Control (Phase 4 / Section 1)
# -----------------------------------------------------------------------------
# When set to true, protected API routes enforce valid Supabase JWT tokens.
# When false (default for prototypes), the system provides a clearly-labelled DEMO MODE login.
ENABLE_AUTH=false
ENABLE_SIGNUP=false
ENABLE_PASSWORD_RESET=false

# -----------------------------------------------------------------------------
# Gmail Inbox Integration (Phase 7 / Section 1)
# -----------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Credentials (Authorized redirect URI required).
# Scope requested: https://www.googleapis.com/auth/gmail.readonly (read-only).
# If absent, the app remains in "Gmail Not Configured" state with mock capabilities.
GMAIL_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REDIRECT_URI=http://localhost:8000/gmail/callback

# -----------------------------------------------------------------------------
# Security Policies & Impersonation Defense
# -----------------------------------------------------------------------------
ORG_DOMAINS=mycompany.com,support.mycompany.com,acme.com

# -----------------------------------------------------------------------------
# Server Network & CORS
# -----------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
ENVIRONMENT=development
