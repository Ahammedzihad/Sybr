# Frontend Environment Configuration Example (NO SECRETS COMMITTED)
# Point VITE_API_URL to your local backend or hosted Render service URL
VITE_API_URL=http://localhost:8000

# Optional: Supabase Publishable / Anon credentials for direct client-side session listener
# (Only anon keys with prefix sb_publishable_... or public JWTs; NEVER place service_role key here)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
