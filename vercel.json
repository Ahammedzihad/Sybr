{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(health|docs|redoc|openapi.json|auth/.*|customer/.*|admin/.*|analyze|copilot/.*|gmail/.*|conversations.*|upload|jobs/.*|dashboard|issues|trends|eval)",
      "dest": "api/index.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/dist/$1"
    },
    {
      "src": "/.*",
      "dest": "frontend/dist/index.html"
    }
  ]
}
